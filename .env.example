# Server-only. Never prefix these variables with NEXT_PUBLIC_.
PAIFLOW_BASE_URL=https://beta.app.paiflow.xyz
PAIFLOW_DEPLOYMENT_ID=
# pfd_ developer token with Read and operate + selected deployment, or legacy pfk_.
PAIFLOW_API_TOKEN=
# Demo sign-in gate. One shared username/password per role; server-checked, HttpOnly signed cookie.
DEMO_USERNAME=
DEMO_PASSWORD=
# Admin role: curates the student directory via the admin panel.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Optional HMAC secret for session cookies (>=16 chars). Falls back to PAIFLOW_API_TOKEN.
APP_SESSION_SECRET=
